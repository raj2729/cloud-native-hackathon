# Elasticsearch — defaults to localhost:9200, which is what docker-compose exposes.
ELASTICSEARCH_URL=http://localhost:9200

# Claude: talk tagging, profile enrichment, match rationales.
# Optional. Without it, lib/ai.ts falls back to deterministic keyword extraction.
ANTHROPIC_API_KEY=

# ElevenLabs Scribe: server-side speech-to-text for voice navigation.
ELEVENLABS_API_KEY=sk_fad30ea86b68f77be8a0db36b92d6b024432880940676fa0

# Set to "false" to force the deterministic path even when a key is present.
AI_ENABLED=true

# Dash0 (OpenTelemetry). Optional — without both of the first two, the OTel SDK
# is never started and the app runs unchanged.
DASH0_ENDPOINT=
DASH0_AUTH_TOKEN=
DASH0_DATASET=default
OTEL_SERVICE_NAME=converge
# Optional label for the deployment.environment.name resource attribute.
DEPLOYMENT_ENV=hackathon

# Commit SHA reported by /api/version and used as OTel service.version. Most
# hosts inject one automatically (Vercel, Render, Railway, Heroku).
APP_VERSION=

# TEST ONLY: adds this many ms to every recommend.talks span to exercise the CI
# latency gate. Leave empty in real deployments.
LATENCY_INJECT_MS=

# Dash0 query API (server-only) — used by the organizer health panel.
DASH0_API_URL=

# Dash0 website monitoring (browser). These are PUBLIC — they ship in page
# source. Use a separate token with only the "Ingesting" permission.
NEXT_PUBLIC_DASH0_ENDPOINT=
NEXT_PUBLIC_DASH0_AUTH_TOKEN=
NEXT_PUBLIC_DASH0_DATASET=default
NEXT_PUBLIC_DEPLOYMENT_ENV=hackathon
